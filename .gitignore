# ---------------------------------------------------------------------------
# Node.js - Dependencies & Lockfiles
# ---------------------------------------------------------------------------
node_modules/
jspm_packages/
web_modules/

# Optional: Un-comment if you use Yarn Berry (v2+) zero-installs
# !.yarn/cache
# !.yarn/patches
# !.yarn/plugins
# !.yarn/releases
# !.yarn/sdks
# !.yarn/versions

# ---------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL for security)
# ---------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example # Keep this tracked as a template for other developers

# ---------------------------------------------------------------------------
# Build Outputs & Production Artifacts
# ---------------------------------------------------------------------------
dist/
build/
out/
.next/
.nuxt/
.remix/
.cache/
.parcel-cache/

# ---------------------------------------------------------------------------
# Logs and Runtime Diagnostics
# ---------------------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------------------------
# Testing & Coverage Outputs
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
.jest/

# ---------------------------------------------------------------------------
# Editor / OS-Specific Files
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json # Share recommended extensions with your team
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
